# Base Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Auth & Database (Postgres)
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Stripe Payments & Customer Portal (Test Mode during development)
# Found in Stripe Dashboard -> Developers -> API Keys & Webhooks
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# Stripe Webhook Signing Secret (from `stripe listen --forward-to localhost:3000/api/stripe/webhook` or Dashboard)
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Email Delivery (Resend)
RESEND_API_KEY=your_resend_api_key_here
NOTIFICATION_EMAIL=Sakib@witlyn.com

# LLM for AI Gap & Opportunity Diagnostic Report
OPENAI_API_KEY=your_openai_api_key_here
# Optional Anthropic Claude fallback:
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Slack Notifications (Optional)
SLACK_WEBHOOK_URL=your_slack_webhook_url_here

# Cal.com Booking
NEXT_PUBLIC_CAL_LINK=https://cal.com/sakib-ziad/strategy-call
